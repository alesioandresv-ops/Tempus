# =============================================================================
# Tempus - Variables de entorno
# =============================================================================
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
#
# Todos los valores de este archivo son EJEMPLOS SEGUROS. Ninguno es una credencial
# real. Generar secretos con:  openssl rand -hex 32
#
# La configuración se valida al arrancar (pydantic-settings): si falta una variable
# obligatoria o un valor es inválido, la aplicación NO levanta y dice cuál. Es
# intencional: es preferible fallar en el deploy que descubrir a las 3am que la
# firma de los webhooks no verifica porque falta un secreto.
#
# Este archivo esta cubierto por un test
# (`test_config_cubre_todas_las_variables_del_env_example`) que falla si se agrega o
# se renombra un campo de `Settings` sin documentarlo acá. O sea: agregar una
# variable al código y olvidar este archivo rompe el CI, no la producción.
#
# VARIABLES OBLIGATORIAS (sin ellas la app no levanta, con un mensaje que dice cual
# falta). Todas llevan ejemplo seguro acá abajo; generar los secretos con
# `openssl rand -hex 32` (y ENCRYPTION_KEY con `openssl rand -base64 32`):
#   DATABASE_URL, DATABASE_MIGRATION_URL, JWT_SECRET_KEY, ENCRYPTION_KEY,
#   SCHEDULER_TICK_SECRET
# =============================================================================


# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
# local | test | staging | production
ENVIRONMENT=local

# Determina los valores por defecto de los otros grupos. En producción fuerza:
# cookies seguras, HTTPS obligatorio, y los secretos a estar presentes.
# DEBUG=true con ENVIRONMENT=production hace fallar el arranque, a proposito.
DEBUG=false

# Dominio canónico. Se usa para construir URLs absolutas (enlaces de gestión,
# redirecciones OAuth de Meta) y para la política de CORS.
PUBLIC_DOMAIN=localhost:5173

# Orígenes permitidos por CORS, separados por coma. Nunca usar "*" con credenciales.
# Acepta CSV (lo de acá) o JSON (lo que produce `docker compose` al serializar una
# lista). Los dos formatos se parsean de verdad, no solo se documentan.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Driver asíncrono. asyncpg es el driver nativo de PostgreSQL para asyncio.
# La contraseña va URL-encoded si contiene caracteres especiales.
#
# Son DOS roles y no uno, y no es una redundancia:
#   - `tempus_app`    sirve tráfico. No tiene DDL y no es dueño de las tablas.
#   - `tempus_owner`  corre migraciones. Dueño de las tablas, con DDL.
#
# Con un solo rol, `FORCE ROW LEVEL SECURITY` deja de proteger nada: el dueño de
# una tabla bypasea sus propias políticas, así que la app sería equivalente a
# superusuario. Ver ARCHITECTURE.md §7 y ADR-0002.
#
# IMPORTANTE sobre RLS: la app inyecta el tenant con `SET LOCAL
# app.current_business_id` al inicio de cada transacción. Con un pool de conexiones
# en modo transaccional, eso funciona bien. Si alguna vez se cambiara a `SET` a
# nivel de sesión, habría fuga entre tenants.
DATABASE_URL=postgresql+asyncpg://tempus_app:tempus_app_dev_pw@localhost:5433/tempus

# Solo para Alembic. El proceso de la API nunca lee esta variable.
DATABASE_MIGRATION_URL=postgresql+asyncpg://tempus_owner:cambiame_en_produccion@localhost:5433/tempus

# Base de los tests de integración. Es un rol SIN permisos de DDL a propósito: los
# tests tienen que demostrar que la app funciona sin ellos.
# Los tests se saltan con un mensaje explícito si no está definida; con esto defined,
# corren contra PostgreSQL real, que es la única forma de probar RLS de verdad.
TEST_DATABASE_URL=postgresql+asyncpg://tempus_app:tempus_app_dev_pw@localhost:5433/tempus_test

# Rol que usa la aplicación. Se registra en los logs de arranque para que un
# despliegue con el rol equivocado sea visible en el primer arranque.
DB_APP_ROLE=tempus_app

# TLS con la base. En producción, obligatorio. Los poolers de Neon y Supabase lo
# exigen; con conexión directa hay que habilitarlo explícitamente.
DATABASE_SSL=false

# Pool de conexiones. `pool_size` debe ser menor que `max_connections` del servidor
# dividido por la cantidad de procesos (api + worker).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Nivel de aislamiento de la transacción. Se usa READ COMMITTED: la garantía de no
# doble reserva la da la restricción EXCLUDE, no el nivel de aislamiento (ADR-0008).
# Subirlo a SERIALIZABLE no agrega nada y multiplica los reintentos por conflicto.
DB_ISOLATION_LEVEL=READ COMMITTED


# -----------------------------------------------------------------------------
# SEGURIDAD: SECRETOS DE AUTENTICACIÓN
# -----------------------------------------------------------------------------
# Generar: openssl rand -hex 32
# Si esto se filtra, cualquiera puede firmar access tokens.
# Mínimo 32 caracteres, y distinto de SCHEDULER_TICK_SECRET: el arranque falla si
# se repite, porque un solo secreto para dos costos deja exposed todo lo que protege
# el otro.
JWT_SECRET_KEY=cambiame_en_produccion_openssl_rand_hex_32

# Access token: vida corta a propósito, porque se renueva con el refresh token.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ALGORITHM=HS256

# Emisor y audiencia: validación extra del token. Cambiarlos invalida todos los
# tokens emitidos.
JWT_ISSUER=tempus
JWT_AUDIENCE=tempus-api

# Refresh token: 30 días de vida máxima por token. La rotación limita el daño real
# a una ventana mucho menor (ver ARCHITECTURE.md §10).
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie de refresh. Secure debe ser true en producción; el arranque falla si no.
# SameSite=Strict porque el access token va solo por header, no por cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# Path acotado a las rutas de autenticación: reduce la superficie en caso de XSS.
# Tiene que coincidir con el prefijo real de la API (`/api/v1`). Si esta ruta no
# existe, la cookie se manda en todas las peticiones y la mitigación desaparece en
# silencio.
COOKIE_PATH=/api/v1/auth

# Clave de cifrado para los secretos de terceros en reposo (token de WhatsApp de
# cada negocio). Generar con: openssl rand -base64 32
# Debe decodificar a EXACTAMENTE 32 bytes: el arranque lo valida. Es una clave
# DISTINTA de JWT_SECRET_KEY. Rotarla exige re-cifrar los tokens.
ENCRYPTION_KEY=cambiame_openssl_rand_base64_32

# Argon2id. Los valores por omisión de pwdlib ya son razonables; se exponen para
# poder ajustarlos sin cambiar código. Subir más time_cost y memory_cost = más
# lento = más seguro, con el costo correspondiente en la latencia de login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4


# -----------------------------------------------------------------------------
# RATE LIMITING (implementado sobre PostgreSQL, ver ARCHITECTURE.md §10.5)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=5
RATE_LIMIT_LOGIN_PER_EMAIL=10
RATE_LIMIT_PUBLIC_BOOKING_PER_IP=10
RATE_LIMIT_PUBLIC_BOOKING_PER_PHONE_HOURLY=5
RATE_LIMIT_REGISTER_BUSINESS_PER_IP_HOURLY=3
RATE_LIMIT_GENERAL_PER_IP=120
RATE_LIMIT_ADMIN_PER_USER=600
RATE_LIMIT_SCHEDULER_TICK=2


# -----------------------------------------------------------------------------
# WHATSAPP - META CLOUD API
# -----------------------------------------------------------------------------
# Credenciales de la APP de Meta (no del negocio). Se usan para verificar la
# firma de los webhooks. Es la app de la plataforma, no la WABA del tenant.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_API_BASE_URL=https://graph.facebook.com

# Verificación del webhook GET de Meta. Meta lo usa para confirmar la URL.
META_WEBHOOK_VERIFY_TOKEN=

# Plantillas de plataforma que se ofrecen a todos los negocios nuevos. Deben
# existir en la WABA de la plataforma y estar APROBADAS por Meta.
# Fuera de la ventana de 24h de Meta, solo se pueden enviar plantillas (ADR-0012).
WHATSAPP_PLATFORM_TEMPLATE_CONFIRMATION=
WHATSAPP_PLATFORM_TEMPLATE_REMINDER_2H=
WHATSAPP_PLATFORM_TEMPLATE_REMINDER_1H=
WHATSAPP_PLATFORM_TEMPLATE_CANCELLED=
WHATSAPP_PLATFORM_TEMPLATE_RESCHEDULED=

# Idioma por defecto de las plantillas. Debe coincidir con el `language_code` de
# las plantillas aprobadas en Meta.
WHATSAPP_DEFAULT_LOCALE=es_AR

# Catálogo de precios de WhatsApp para estimar el costo por mensaje y avisar cuando
# un tenant se acerca a su presupuesto. Los valores son de referencia y hay que
# actualizarlos desde la documentación de Meta, que los cambia periódicamente.
WHATSAPP_PRICING_CURRENCY=USD
WHATSAPP_PRICING_MARKETING=0.012
WHATSAPP_PRICING_UTILITY=0.008
WHATSAPP_PRICING_SERVICE=0.008

# Alerta al superar el gasto mensual estimado de WhatsApp del negocio.
WHATSAPP_MONTHLY_BUDGET_ALERT=25.00

# Número máximo de mensajes por tenant por hora. Corta antes de agotar la cuota de
# Meta si hay un bug en un tenant.
WHATSAPP_TENANT_HOURLY_CAP=500


# -----------------------------------------------------------------------------
# BACKGROUND JOBS
# -----------------------------------------------------------------------------
# Tick interno del drenador de jobs, en segundos. Es la red de seguridad: el
# disparador principal es el Cloudflare Worker con cron (ADR-0014).
SCHEDULER_TICK_SECONDS=30

# Jobs tomados por lote. Ajustar según el tiempo de drenaje observado.
JOB_BATCH_SIZE=25

# Lease: un job "running" con locked_at más viejo que esto vuelve a "pending".
# Es la recuperación de un worker que murió a mitad de un envío.
JOB_LEASE_TIMEOUT_SECONDS=300

JOB_MAX_ATTEMPTS=5

# Habilitar el drenador dentro del proceso de la API. En producción va en true
# (ver ADR-0014: es lo que mantiene vivos los recordatorios cuando el servicio
# esté despierto). En tests, false.
ENABLE_INLINE_SCHEDULER=true

# Secret del endpoint interno POST /api/v1/internal/scheduler/tick.
# Lo comparten el Cloudflare Worker y el backend. Comparación en tiempo constante.
SCHEDULER_TICK_SECRET=cambiame_openssl_rand_hex_32

# Colas y su concurrencia. Los reportes pueden esperar, los recordatorios no.
JOB_QUEUES=reminders,whatsapp_outbound,webhooks,media,reports
JOB_CONCURRENCY=5

# Retención de jobs terminados, en días.
JOB_RETENTION_DAYS=30


# -----------------------------------------------------------------------------
# ALMACENAMIENTO (Cloudflare R2, compatible con S3)
# -----------------------------------------------------------------------------
# Las imágenes NO van dentro de PostgreSQL (PROJECT_MASTER §26).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tempus-media
R2_PUBLIC_BASE_URL=https://media.<dominio>

# Presign: el cliente sube directamente a R2, sin pasar por la API. Evita que el
# backend sea un relay de archivos de varios megas.
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_PRESIGN_EXPIRE_SECONDS=300

# Formatos de imagen aceptados. El contenido real se verifica: no se confía en la
# extensión ni en el Content-Type del cliente.
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

MEDIA_MAX_WIDTH=2000
MEDIA_MAX_HEIGHT=2000


# -----------------------------------------------------------------------------
# DISPONIBILIDAD: VALORES POR DEFECTO
# -----------------------------------------------------------------------------
# Se aplican al crear un negocio. Son editables por negocio.
# El timezone se valida contra la base IANA al arrancar: uno inexistente no falla
# en el deploy, falla meses después cuando un negocio nuevo no muestra disponibilidad.
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
DEFAULT_LOCALE=es-AR
DEFAULT_CURRENCY=ARS
DEFAULT_SLOT_INTERVAL_MINUTES=15
DEFAULT_MIN_LEAD_MINUTES=60
DEFAULT_MAX_ADVANCE_DAYS=60
DEFAULT_CANCELLATION_WINDOW_MINUTES=120

# Tope duro del rango que se puede pedir en una consulta de disponibilidad.
# Protege contra un cliente que pida un año entero.
AVAILABILITY_MAX_RANGE_DAYS=31

# TTL de la caché de disponibilidad, en segundos. Es una optimización, NO una
# garantía: el backend siempre revalida antes de escribir.
AVAILABILITY_CACHE_TTL_SECONDS=30

# Ventana de cancelación una vez iniciado el turno, en minutos.
BOOKING_ALLOW_CANCEL_AFTER_START_MINUTES=0


# -----------------------------------------------------------------------------
# OBSERVABILIDAD
# -----------------------------------------------------------------------------
# json en producción, texto legible en local. En staging y producción, LOG_FORMAT
# tiene que ser json: el arranque falla con `console`.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Nunca registrar valores de estas claves. La lista se aplica al pipeline de logs.
# En una sola línea: dotenv no interpreta continuaciones con barra invertida.
LOG_REDACT_KEYS=password,password_hash,access_token,refresh_token,token,secure_token,access_token_encrypted,app_secret_encrypted,authorization

# Enviar datos de clientes a un servicio de terceros. En producción debe ser false;
# el arranque falla si es true.
LOG_CLIENT_DATA=false


# -----------------------------------------------------------------------------
# FRONTEND (build-time)
# -----------------------------------------------------------------------------
# URL pública de la API. En producción, mismo dominio que el frontend.
# El prefijo `/api/v1` es el mismo que usa `COOKIE_PATH` y que documenta
# ARCHITECTURE.md. Sin la `v1` el frontend pegaría a rutas inexistentes.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Clave pública de Cloudflare Turnstile. El "sitekey" es público por definición;
# el "secret" del servidor va en TURNSTILE_SECRET, no acá.
VITE_TURNSTILE_SITE_KEY=

# Verificación del token de Turnstile en el backend (lado servidor).
TURNSTILE_SECRET=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Activar Turnstile en el booking público. Es la defensa contra el abuso que dispara
# el costo de WhatsApp.
TURNSTILE_ENABLED=false


# -----------------------------------------------------------------------------
# PLATAFORMA ADMIN
# -----------------------------------------------------------------------------
# Identificadores de la app de Meta para el OAuth Embedded Signup. El negocio
# autoriza a la plataforma a enviar en su nombre, y Meta deja de tratar el envío
# como si fuera de un tercero. Ver ADR-0013.
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Email de soporte. Aparece en la página pública del negocio.
SUPPORT_EMAIL=ayuda@tempus.app
