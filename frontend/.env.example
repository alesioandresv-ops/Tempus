# Origen del backend, SIN el prefijo /api/v1 (ej: https://api.tempus.app).
# El frontend lo agrega: src/services/api.ts arma `${VITE_API_URL}/api/v1`.
# En dev, dejalo vacío: se usa la ruta relativa y el proxy de Vite manda a :8000.
VITE_API_URL=

# Dominio raíz para detectar el subdominio de negocio en el login (hoy no hay
# subdominios). Ej: tempus.app
VITE_ROOT_DOMAIN=

# Clave pública (sitekey) de Cloudflare Turnstile. Es pública por definición.
VITE_TURNSTILE_SITE_KEY=
